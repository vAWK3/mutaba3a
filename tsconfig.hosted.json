// The hosted portal (MUT-43) is its own program: the app registers its router
// type globally in src/router.tsx, which must not type the portal's routes, and
// the app program must never see portal code (hosted-portal.md §8).
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.hosted.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* MUT-286: the lazy local backend's types, not its code (session/localBackendContract.ts explains the split) */
    "paths": {
      "@mut/local-backend": ["./src/hosted/session/localBackendContract.ts"],
      "@mut/records-export": ["./src/hosted/session/recordsExportContract.ts"]
    }
  },
  "include": ["src/hosted", "src/vite-env.d.ts"],
  // src/hosted/local/** (MUT-286) runs the server's own route modules in the page and is checked separately, under
  // tsconfig.hosted-local.json, whose settings mirror server/tsconfig.json's strictness instead of this program's
  // (see that file's comment: checking those files here collapses zod's generic `createRoute` types to `never`).
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**", "src/hosted/local/**"]
}
