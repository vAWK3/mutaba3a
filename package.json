{
  "name": "mutaba3a",
  "private": true,
  "version": "0.1.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "dev:desktop": "vite --mode desktop",
    "dev:hosted": "vite --mode hosted",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --mode web",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "build:hosted": "tsc -b && vite build --mode hosted",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.hosted.json",
    "preview": "vite preview",
    "preview:web": "vite preview --mode web --outDir dist-web",
    "preview:desktop": "vite preview --mode desktop --outDir dist-desktop",
    "preview:hosted": "vite preview --mode hosted --outDir dist-hosted",
    "tauri": "tauri",
    "icons:desktop": "tauri icon public/icons/icon-1024.png && node -e \"for (const d of ['android', 'ios']) require('fs').rmSync('src-tauri/icons/' + d, { recursive: true, force: true })\"",
    "deploy": "./deploy.sh",
    "release": "tsx scripts/release.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:tz": "TZ=America/New_York vitest run",
    "test:bundles": "vite build --mode web && vite build --mode desktop && vite build --mode hosted && tsx scripts/check-bundles.ts",
    "hosted:types": "openapi-typescript server/openapi/openapi.yaml -o src/hosted/api/schema.d.ts",
    "hosted:types:check": "tsx scripts/check-hosted-types.ts",
    "i18n:check": "tsx scripts/check-i18n-keys.ts",
    "release:notes": "tsx scripts/check-release-notes.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "^1.144.0",
    "@tanstack/react-router-devtools": "^1.144.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dexie": "^4.2.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "motion": "13.4.4",
    "posthog-js": "1.435.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.70.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "nanoid": "^5.1.16",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.23",
    "prettier": "^3.7.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
