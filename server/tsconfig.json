{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist"
    // No explicit `rootDir`: MUT-286's platform-shim.test.ts (the one file outside `server/` the program touches)
    // imports the hosted build's browser shims it checks byte-for-byte against real node:crypto/Buffer
    // (src/hosted/local/platform/**, excluded from the real build by tsconfig.build.json's own test exclusions
    // below it). An explicit `rootDir: "src"` makes `tsc --noEmit` (this config; no file is ever written) refuse that
    // import as "not under rootDir" even though nothing is emitted. Every file `tsconfig.build.json` actually emits
    // still lives under `server/src/**` (the cross-directory import is test-only), so `dist/`'s layout is unaffected
    // — TS infers the same root from that program's own narrower file set.
  },
  "include": ["src"]
}
