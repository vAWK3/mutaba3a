# Copy to production.tfvars (git-ignored). image_tag is passed by scripts/deploy.sh.
project_id          = "your-gcp-project"
region              = "me-west1"
environment         = "production"
db_tier             = "db-g1-small"
db_availability     = "REGIONAL"
db_backup_enabled   = true
deletion_protection = true
min_instances       = 1
# MUT-270: Prisma pool per instance, and Cloud SQL's max_connections (see the precondition on the DATABASE_URL secret in main.tf).
# db_pool_size        = 10
# db_max_connections  = 50
log_level           = "info"
# MUT-381: our own KMS key. Walk off → prepared → active only as server/DEPLOYMENT.md §6d says.
# cmek_stage          = "off"
# MUT-360: Stripe webhook and nightly reconcile. Set true only after both Stripe secrets hold a version (server/DEPLOYMENT.md §6e).
# stripe_enabled      = false
# MUT-148: error reports to Sentry. Set true only after server/DEPLOYMENT.md §1.5 has applied the Sentry stack.
# sentry_enabled      = false
# MUT-389: the receipts library. Set true when MUT-260 or MUT-258 ships, and leave it on (server/DEPLOYMENT.md).
# receipts_library_enabled = false
# MUT-436: agents adding to the inbox. Only after the phone release decoding 'mcp' is live and the minimum build is raised.
# mcp_inbox_writes_enabled = false
# MUT-441: the server reads receipts. Only when piloting, and only after MUT-487's project move (docs/operations/before-release.md).
# server_ocr_enabled = false
# ocr_min_instances  = 0   # R4: 1 keeps one warm (about $50-70 a month)
# Uptime alerts (MUT-328, server/DEPLOYMENT.md §6b). Real values only in the git-ignored production.tfvars.
# alert_email      = "you@example.com"
# alert_sms_number = "+9725XXXXXXXX"   # E.164; verify the SMS channel once after the apply
# uptime_host      = "app.example.com" # set when the custom domain is live (MUT-112); unset = the Cloud Run host
# alert_notification_channels = ["projects/your-gcp-project/notificationChannels/1234567890"]

# App-association files (MUT-111): set all four together, or leave all four
# commented out to disable. See server/DEPLOYMENT.md §4d.
# apple_team_id               = "4LCWA596X7"
# apple_bundle_id             = "com.barmajiyat.mutaba3a"
# android_package_name        = "com.barmajiyat.mutaba3a"
# android_sha256_fingerprints = "AA:BB:...,CC:DD:..."

# Transactional mail (MUT-359, server/DEPLOYMENT.md §6f). Off until the domain is verified in Resend, both secrets
# hold a version and `npm --prefix server run email:check -- --api` passes. The cap stays below the Barmajiyat
# Resend plan's daily limit, which Malafat shares. MUT-366: mail on also mounts the Turnstile secret
# (mutaba3a-api-turnstile-secret must hold a version first), and recovery goes live with it.
# mailer               = "resend"
# mail_reply_to        = "support@example.com"
# mail_daily_cap       = 90
# operator_alert_email = "you@example.com"

# Self-service signup (MUT-366, ADR-159). GA only: after billing (MUT-361/362) and account closing (MUT-333).
# self_signup_enabled = true

# Phone minimum build (MUT-293, MUT-457; DEPLOYMENT.md "Raise the minimum app build"). Unset = no phone is told to
# update. Only raise a floor to a build already live in that store; iOS builds before MUT-457 repeat 1–7, so the
# first iOS floor is 8. Ships with a normal release that names each changed value, e.g.
# ALLOW_MIN_BUILD_CHANGE=ANDROID_MIN_BUILD (MUT-471). Undo: min_build_check_disabled = true (DEPLOYMENT.md).
# android_min_build         = 12
# android_recommended_build = 13
# ios_min_build             = 8
# min_build_check_disabled  = true
