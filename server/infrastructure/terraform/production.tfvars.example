# Copy to production.tfvars (git-ignored). image_tag is passed by scripts/deploy.sh.
project_id          = "your-gcp-project"
region              = "me-west1"
environment         = "production"
db_tier             = "db-g1-small"
db_availability     = "REGIONAL"
db_backup_enabled   = true
deletion_protection = true
min_instances       = 1
# MUT-270: Prisma pool per instance, and Cloud SQL's max_connections (see the precondition on the DATABASE_URL secret in main.tf).
# db_pool_size        = 10
# db_max_connections  = 50
log_level           = "info"
# MUT-381: our own KMS key. Walk off → prepared → active only as server/DEPLOYMENT.md §6d says.
# cmek_stage          = "off"
# MUT-360: Stripe webhook and nightly reconcile. Set true only after both Stripe secrets hold a version (server/DEPLOYMENT.md §6e).
# stripe_enabled      = false
# MUT-148: error reports to Sentry. Set true only after server/DEPLOYMENT.md §1.5 has applied the Sentry stack.
# sentry_enabled      = false
# MUT-389: the receipts library. Set true when MUT-260 or MUT-258 ships, and leave it on (server/DEPLOYMENT.md).
# receipts_library_enabled = false
# Uptime alerts (MUT-328, server/DEPLOYMENT.md §6b). Real values only in the git-ignored production.tfvars.
# alert_email      = "you@example.com"
# alert_sms_number = "+9725XXXXXXXX"   # E.164; verify the SMS channel once after the apply
# uptime_host      = "app.example.com" # set when the custom domain is live (MUT-112); unset = the Cloud Run host
# alert_notification_channels = ["projects/your-gcp-project/notificationChannels/1234567890"]

# App-association files (MUT-111): set all four together, or leave all four
# commented out to disable. See server/DEPLOYMENT.md §4d.
# apple_team_id               = "4LCWA596X7"
# apple_bundle_id             = "com.barmajiyat.mutaba3a"
# android_package_name        = "com.barmajiyat.mutaba3a"
# android_sha256_fingerprints = "AA:BB:...,CC:DD:..."
