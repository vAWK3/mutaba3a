# Copy to production.tfvars (git-ignored). Nothing secret goes in this file: the
# admin token is passed to each command as SENTRY_AUTH_TOKEN="$SENTRY_ADMIN_TOKEN". See server/DEPLOYMENT.md §1.5.
organization = "barmajiyat-ltd"

# Origins each browser DSN accepts events from (R2) come from config/hosts.json
# (MUT-326): its portal and landing origins, new and legacy. Re-apply after the domain
# is set there, or the new hosts' errors are dropped. Extras only: Cloud Run also
# serves the service at https://<service>-<project-number>.<region>.run.app (europe-west1 for mtb3a-production,
# me-west1 for the old project; MUT-523); list it here if anyone reaches the portal through it.
# portal_origins  = []
# landing_origins = []

# Optional overrides (defaults in variables.tf).
# base_url                 = "https://de.sentry.io/api/"
# spike_threshold_per_hour = 10
