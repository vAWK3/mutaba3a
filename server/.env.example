# Mutaba3a API service — environment
#
# Every value is validated at startup by src/config.ts; the process refuses to
# boot with a missing or malformed variable. Nothing here is shipped to a
# browser. In production these come from GCP Secret Manager via Cloud Run
# secret references, never from a file.

NODE_ENV=development
PORT=8787
# MUT-463: listen on this machine only, so the admin API below is not reachable
# from the network. An IP address, not a name. Delete the line to reach the dev
# API from a phone on the same Wi-Fi; Cloud Run leaves it unset (every interface).
HOST=127.0.0.1
LOG_LEVEL=debug

# Postgres. Locally: the docker container from server/README.md. In production:
# the Cloud SQL unix socket form, e.g.
# postgresql://mutaba3a_api:<password>@/mutaba3a?host=/cloudsql/<project>:<region>:<instance>
DATABASE_URL=postgresql://mutaba3a:mutaba3a@localhost:54329/mutaba3a_dev

# Operator credential for /admin/v1/* (organization + API-key provisioning).
# >= 32 random bytes, base64url. Rotate by replacing the secret version.
MUTABA3A_ADMIN_TOKEN=replace-with-32-plus-ryandom-characters-from-secret-manager

# Which key environment this deployment issues and accepts: live | test.
# Staging deployments run with "test" so a production key can never be
# accepted by staging or vice versa.
API_KEY_ENVIRONMENT=test

# Per-API-key request budget, sliding window of 60 seconds.
RATE_LIMIT_PER_MINUTE=300

# Reported by GET /v1/integration and /health. Set from the build in CI.
SERVICE_VERSION=0.1.0-dev

# M6 attachments: private GCS bucket for invoices and receipts. Unset = attachments routes answer 503.
# ATTACHMENTS_BUCKET=my-project-mutaba3a-attachments
# ATTACHMENTS_URL_TTL_SECONDS=900
# MUT-396: local QA and the dev server keep attachments on disk instead (refused in production and staging).
# Signed URLs point back at this server (/dev/attachments/...); files land in ATTACHMENTS_DIR, relative to server/
# (default .data/attachments, gitignored, never swept: delete it to start clean). Don't set ATTACHMENTS_BUCKET with it.
# ATTACHMENTS_DRIVER=local
# ATTACHMENTS_DIR=.data/attachments
# MUT-389: the receipts library (/v1/receipts*; deleting an expense keeps its receipts To review).
# Only "true" turns it on; unset = off, as in production until MUT-260 or MUT-258 ships. Needs storage above
# (the bucket, or ATTACHMENTS_DRIVER=local).
# RECEIPTS_LIBRARY=true

# MUT-436 (ADR-201): a person's own Claude may add expenses to their inbox (captureSource 'mcp'). Only "true" turns it on;
# unset = off, as in production until the phone release that decodes 'mcp' is live and its minimum build is raised.
# MCP_INBOX_WRITES=true

# MUT-361: the lapse gate (READ_ONLY profiles refuse session writes, LOCKED ones all but the records export).
# On unless exactly "false" — the operator's kill switch. Run `npm run billing:uncovered` before turning it on.
# BILLING_GATE=false

# MUT-228 reference exchange rates (GET /v1/fx-rates): ECB rates via Frankfurter, cached per instance.
# FX_RATES_URL must be https; plain http only for a localhost stub (deterministic QA rates).
# FX_RATES_URL=https://api.frankfurter.dev/v1/latest
# FX_RATES_TTL_MINUTES=240
# FX_RATES_TIMEOUT_MS=3000

# MUT-37 portal-user passwords: argon2id cost. Defaults are OWASP profile 1; the
# service refuses to boot below them.
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# MUT-38 portal sessions. The pepper is the HMAC key for session-token digests:
# >= 32 random characters, Secret Manager in production (Terraform generates it).
# Rotating it signs every portal user out.
SESSION_TOKEN_PEPPER=replace-with-32-plus-random-characters-from-secret-manager
# SESSION_IDLE_MINUTES=120
# SESSION_ABSOLUTE_HOURS=12
# MUT-64 device sessions (native app bearer tokens, same pepper as above). Longer
# than a browser session because capture happens days apart.
# DEVICE_SESSION_IDLE_DAYS=30
# DEVICE_SESSION_ABSOLUTE_DAYS=180
# MUT-434 OAuth for MCP agents (Claude): >= 32 random characters, Secret Manager in
# production. Needs PORTAL_ORIGIN (the issuer). Unset = /oauth/*, the OAuth discovery
# documents and /mcp answer 503 OAUTH_NOT_CONFIGURED.
# OAUTH_DERIVE_KEY=replace-with-32-plus-random-characters-from-secret-manager
# The portal's public origin; non-GET session requests must come from it.
# Unset = each request is compared with its own origin (fine locally).
# PORTAL_ORIGIN=https://portal.example.com
# MUT-115 passkeys: the WebAuthn relying-party ID, the apex domain (Terraform sets it from
# config/hosts.json at stage live). Unset = no passkeys (every passkey route answers 404).
# WEBAUTHN_ORIGINS replaces the derived origins (PORTAL_ORIGIN and https://<rp id>); for
# local dev and QA, e.g.:
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:8787,https://localhost
# Proxies in front of the service that append to X-Forwarded-For (Cloud Run = 1).
# TRUSTED_PROXY_HOPS=1

# Error reporting to Sentry EU (ADR-091; read by MUT-148, not yet by src/config.ts).
# Unset = Sentry never starts (dev, tests, CI). In production the DSN reaches
# Cloud Run from Secret Manager; its value is `terraform output -json dsn` (api)
# in server/infrastructure/sentry. See docs/observability/README.md.
# SENTRY_DSN=https://<public key>@<id>.ingest.de.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=mutaba3a-api@<version>+<short sha>   (defaults from SERVICE_VERSION)

# MUT-359 transactional mail (ADR-159 §5, server/DEPLOYMENT.md §6f). noop (default) sends nothing.
# Locally, `memory` keeps mail for GET /admin/v1/dev-outbox (admin token) and `log` prints each mail and its
# link; both are refused in production. `resend` needs every line below it.
# MAILER=memory
# SELF_SIGNUP_ENABLED=false          # MUT-366: opens POST /v1/signups (404 while off); refused with MAILER=noop
# TURNSTILE_SECRET=2x0000000000000000000000000000000AA   # MUT-366: unset = Cloudflare's always-pass test secret
#                                    # (2x… always fails, for QA); MAILER=resend needs one named (production: a real one)
# SIGNUP_RESPONSE_FLOOR_MS=3000      # MUT-366: signup and recovery answer no earlier than this
# RECOVERY_RESPONSE_FLOOR_MS=1500
# MAIL_FROM_ADDRESS=no-reply@mail.example.test
# MAIL_REPLY_TO=help@example.test
# RESEND_API_KEY=re_...              # sending-only, restricted to the domain (Secret Manager in production)
# RESEND_WEBHOOK_SECRET=whsec_...    # the Resend webhook's signing secret
# MAIL_DAILY_CAP=90                  # required with resend; below the shared Resend plan's daily limit
# MAIL_SECURITY_RESERVE=9            # default 10 % of the cap, for recovery mail only
# MAIL_RECIPIENT_DAILY_CAP=10
# OPERATOR_ALERT_EMAIL=you@example.test
