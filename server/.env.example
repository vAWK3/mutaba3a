# Mutaba3a API service — environment
#
# Every value is validated at startup by src/config.ts; the process refuses to
# boot with a missing or malformed variable. Nothing here is shipped to a
# browser. In production these come from GCP Secret Manager via Cloud Run
# secret references, never from a file.

NODE_ENV=development
PORT=8787
LOG_LEVEL=debug

# Postgres. Locally: the docker container from server/README.md. In production:
# the Cloud SQL unix socket form, e.g.
# postgresql://mutaba3a_api:<password>@/mutaba3a?host=/cloudsql/<project>:<region>:<instance>
DATABASE_URL=postgresql://mutaba3a:mutaba3a@localhost:54329/mutaba3a_dev

# Operator credential for /admin/v1/* (organization + API-key provisioning).
# >= 32 random bytes, base64url. Rotate by replacing the secret version.
MUTABA3A_ADMIN_TOKEN=replace-with-32-plus-random-characters-from-secret-manager

# Which key environment this deployment issues and accepts: live | test.
# Staging deployments run with "test" so a production key can never be
# accepted by staging or vice versa.
API_KEY_ENVIRONMENT=test

# Per-API-key request budget, sliding window of 60 seconds.
RATE_LIMIT_PER_MINUTE=300

# Reported by GET /v1/integration and /health. Set from the build in CI.
SERVICE_VERSION=0.1.0-dev
