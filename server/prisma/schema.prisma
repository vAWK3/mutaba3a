// Mutaba3a hosted ledger — Milestone 1 schema (MUT/MAL Money v1 plan, §3.1, §10, §14.2).
//
// Scope of this file: the control tables that make the service organization-
// scoped and auditable before any financial object exists. Financial tables
// (customers, projects, agreements, installments, receivables, payments,
// allocations, reversals, attachments) arrive in M2–M6 as separate migrations.
//
// Invariants enforced here rather than in code:
//   - An API key belongs to exactly one organization (FK).
//   - A key prefix and a key hash are globally unique, so lookup by prefix is
//     unambiguous and two keys can never share a secret.
//   - One Malafat tenant binds to at most one organization, and one
//     organization has at most one integration per provider.
//   - An idempotency key is unique per organization, never globally, so two
//     organizations cannot collide on client-generated keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// MUT-182: an owned profile's kind. Only selects the expense-category preset;
/// BUSINESS is not a firm, a Malafat tenant or a shared organization.
enum ProfileType {
  PERSONAL
  BUSINESS
}

/// MUT-300 (ADR-099): a member's role in a firm. Meaningful only while firm features are on.
enum MembershipRole {
  OWNER
  BOOKKEEPER
  SUBMITTER
}

/// Which deployment issued a key. A "test" key is rejected by a "live"
/// deployment and vice versa (see config.API_KEY_ENVIRONMENT).
enum ApiKeyEnvironment {
  live
  test
}

enum IntegrationProvider {
  MALAFAT
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AuditActorType {
  API_KEY
  ADMIN
  SYSTEM
  /// A signed-in person acting through a session (MUT-38); actorId = user id.
  USER
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
}

enum ExternalEntityType {
  CUSTOMER
  PROJECT
}

enum VatTreatment {
  STANDARD_RATED
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
}

enum PricingBasis {
  VAT_EXCLUSIVE
  VAT_INCLUSIVE
}

enum AgreementType {
  FIXED
  RECURRING
  /// MUT-100: an upfront fee plus a commission (one rate) on the awarded amount.
  CONTINGENCY
}

/// MUT-100: whether a contingency agreement's upfront stays on top of the commission or counts toward it.
enum UpfrontTreatment {
  SEPARATE
  CREDITED
}

/// MUT-100: how a contingency case ended. No outcome yet = null on the agreement.
enum ContingencyOutcome {
  AWARDED
  NO_RECOVERY
}

enum AgreementStatus {
  ACTIVE
  CANCELLED
}

enum TriggerType {
  IMMEDIATE
  DATE
  MANUAL
}

enum PaymentTerms {
  IMMEDIATE
  EOM
  EOM_15
  EOM_30
  EOM_45
  EOM_60
}

enum ReceivableOrigin {
  INSTALLMENT
  RETAINER_CHARGE
  ADJUSTMENT
}

enum ReceivableStatus {
  OPEN
  SETTLED
}

enum PaymentMethod {
  CASH
  BANK
}

enum PaymentStatus {
  POSTED
  REVERSED
}

enum FinalMonth {
  FULL
  PRORATE
  WAIVE
}

enum SupplementDistribution {
  LAST_UNPOSTED
  PRORATE_UNPOSTED
  NEW_INSTALLMENT
}

model Organization {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String       @unique
  /// ISO 4217. Default for new projects; each project still carries its own.
  defaultCurrency       String       @db.VarChar(3)
  /// IANA zone used by the recurring-charge scheduler (plan §5.4).
  timezone              String
  /// MUT-120: set on a user's one personal organization (created with the
  /// user), null on every firm. Unique, so a user has at most one; such an
  /// organization is never bound to Malafat, issued an API key or shared.
  personalOwnerUserId   String?      @unique @db.Uuid
  personalOwner         User?        @relation("PersonalProfile", fields: [personalOwnerUserId], references: [id], onDelete: Restrict)
  /// MUT-182: the user who owns and controls this profile — one they created
  /// with POST /v1/profiles, or their MUT-120 personal one. Null on every
  /// operator-provisioned firm. Not unique: up to MAX_OWNED_PROFILES per user.
  /// An owned profile is standalone: never keyed, bound to Malafat or shared.
  ownerUserId           String?      @db.Uuid
  owner                 User?        @relation("OwnedProfiles", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// MUT-182: set exactly when ownerUserId is (CHECK); picks the expense preset.
  profileType           ProfileType?
  /// MUT-182: If-Match for PATCH /v1/profiles/{id}.
  version               Int          @default(1)
  /// MUT-300 (ADR-099): firm features are on from this instant; null = off. Set only by an
  /// operator, in place on an owned Business profile or on an operator firm (eng review D4).
  /// Never on the built-in personal profile (CHECK).
  firmEnabledAt         DateTime?
  /// MUT-300: the owner asked for firm features (POST /v1/profiles/{id}/firm-request); cleared
  /// when an operator enables or declines. Set together with firmRequestedByUserId (CHECK).
  firmRequestedAt       DateTime?
  firmRequestedByUserId String?      @db.Uuid
  /// MUT-333 (D7): SET NULL, so a pending request outlives its requester's account (the pair CHECK allows it).
  firmRequestedBy       User?        @relation("FirmRequests", fields: [firmRequestedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  apiKeys            ApiKey[]
  integrations       Integration[]
  auditEvents        AuditEvent[]
  idempotencyKeys    IdempotencyKey[]
  customers          Customer[]
  projects           Project[]
  externalReferences ExternalReference[]
  vatRates           VatRate[]
  agreements         Agreement[]
  receivables        Receivable[]
  payments           Payment[]

  attachments  Attachment[]
  feeProposals FeeProposal[]
  memberships  Membership[]

  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  vendors               Vendor[]
  vendorNames           VendorName[]
  expenseReceipts       ExpenseReceipt[]
  conversions           Conversion[]
  /// MUT-267: expense groups (trips) and their keep/leave-out marks.
  expenseGroups         ExpenseGroup[]
  expenseGroupOverrides ExpenseGroupOverride[]

  /// MUT-358: subscriptions tied to this profile (a Firm subscription), and operator grants on it.
  billingSubscriptions BillingSubscription[]
  entitlementGrants    EntitlementGrant[]

  @@index([ownerUserId])
  @@map("organizations")
}

model ApiKey {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id])
  name           String
  environment    ApiKeyEnvironment
  /// The public 8-character segment of the key, used for lookup and masking.
  prefix         String            @unique @db.VarChar(8)
  /// SHA-256 (hex) of the full key string. The key itself is never stored.
  keyHash        String            @unique @db.VarChar(64)
  /// Validated against auth/scopes.ts on every read; stored as text so a new
  /// scope never needs a migration.
  scopes         String[]
  createdAt      DateTime          @default(now())
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedReason  String?

  @@index([organizationId])
  @@map("api_keys")
}

enum UserStatus {
  ACTIVE
  DISABLED
  /// MUT-367 (ADR-159 §7a, ADR-178): a self-service signup from a webmail, relay or unverified domain, waiting for
  /// the operator. Can't sign in (403 ACCOUNT_UNDER_REVIEW with the right password); can recover; has no trial yet.
  PENDING_REVIEW
}

/// MUT-367: what the signup screen made of an address's domain (server/src/email/domains).
enum EmailDomainClass {
  /// MX, a resolving apex or www, and an RDAP registration at least 90 days old: signs up at once.
  BUSINESS
  /// Not webmail, but a check failed, timed out or couldn't be answered, or a relay service: waits for review.
  BUSINESS_UNVERIFIED
  /// On the vendored free-webmail list: waits for review.
  WEBMAIL
}

/// MUT-367: the operator's answer to a signup review.
enum SignupReviewDecision {
  APPROVED
  DECLINED
}

/// A person who may sign in to the hosted portal (MUT-37, ADR-037). Issued by
/// the operator, or (MUT-366, ADR-159) created by redeeming a self-service
/// SIGNUP link; recovery mails a reset link. Not organization-scoped: access
/// is the Membership join.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Normalised before storage (trim, NFKC, lower-case), so uniqueness is case-insensitive.
  email              String     @unique
  displayName        String
  /// argon2id PHC string. The password itself is never stored.
  /// MUT-235: NULL until the person sets one through their setup link (and after a reset with --lock).
  passwordHash       String?
  /// 'en' | 'ar', validated by the API.
  locale             String     @db.VarChar(5)
  status             UserStatus @default(ACTIVE)
  /// Written by sign-in (MUT-38).
  failedSignIns      Int        @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime
  lastSignInAt       DateTime?
  /// MUT-366 (D18): when the person proved they read this address: a signup, or redeeming a mailed recovery link.
  emailVerifiedAt    DateTime?
  /// MUT-191: `{ off, dismissed[] }` for the Malafat suggestions; NULL = on, nothing dismissed.
  malafatSuggestions Json?
  /// MUT-418: `{ welcomedAt, welcomeAnswer, bannerSnoozedUntil }`, the person's answers to the trial's card prompt
  /// (server/src/billing/trial-prompt.ts); NULL = nothing answered yet.
  trialPrompt        Json?
  /// MUT-370: `{ notNowCount, hiddenUntil }`, the "Add a passkey" suggestion's state (server/src/auth/passkey-prompt.ts);
  /// NULL = never answered. Read and written through the passkeys port, never part of the person's record.
  passkeyPrompt      Json?
  createdAt          DateTime
  updatedAt          DateTime

  memberships      Membership[]
  sessions         Session[]
  /// MUT-235: one-time setup links; at most one open at a time.
  setupLinks       AccountSetupToken[]
  /// MUT-324: every terms version this person accepted.
  termsAcceptances TermsAcceptance[]
  /// MUT-120: the organization created with this user as their personal profile.
  personalProfile  Organization?       @relation("PersonalProfile")
  /// MUT-182: every profile this user owns, the personal one included.
  ownedProfiles    Organization[]      @relation("OwnedProfiles")
  /// MUT-300: firm-feature requests this user made (MUT-333: SET NULL when the account is deleted).
  firmRequests     Organization[]      @relation("FirmRequests")

  expenses            Expense[]
  expenseReceipts     ExpenseReceipt[]     @relation("ReceiptUploadedBy")
  /// MUT-255: receipts this person approved into an expense.
  approvedReceipts    ExpenseReceipt[]     @relation("ReceiptApprovedBy")
  conversions         Conversion[]
  /// MUT-267: groups this person created.
  expenseGroups       ExpenseGroup[]
  /// MUT-65: income captured by this person.
  payments            Payment[]
  /// MUT-66: this person's unsorted captures, owned by them and by no profile.
  inboxEntries        InboxEntry[]
  /// MUT-131: this person's idempotency claims for organization-independent writes.
  userIdempotencyKeys UserIdempotencyKey[]
  /// MUT-434: the agents (MCP clients) this person connected, and the consent requests they decided.
  oauthGrants         OAuthGrant[]
  oauthRequests       OAuthAuthorizationRequest[]

  /// MUT-358 (ADR-160): when this person's 14-day trial began. NULL = no trial (every operator-issued account);
  /// MUT-331's self-service signup sets it at email verification.
  trialStartedAt    DateTime?
  /// MUT-358: the Stripe customer this person pays through, once linked.
  billingAccount    BillingAccount?
  /// MUT-358: operator grants covering this person's own profiles.
  entitlementGrants EntitlementGrant[]
  /// MUT-433 (ADR-196): operator-granted feature flags (server/src/features.ts).
  featureGrants     UserFeatureGrant[]
  /// MUT-367: the review a PENDING_REVIEW signup waits on (kept, unlinked, after a decline).
  signupReview      SignupReview?

  /// MUT-333 (ADR-188, D18): Close my account. Set together (CHECK); the account is deleted once deleteAfter passes.
  closeRequestedAt          DateTime?
  deleteAfter               DateTime?
  /// MUT-333 (D1): the Stripe subscriptions this closing set to end, so "Keep my account" turns back on only those.
  closeEndedSubscriptionIds String[]  @default([])
  /// MUT-333 (R1): the hard delete's claim; once set, the closing can no longer be cancelled. R13: retries' order.
  purgeStartedAt            DateTime?
  purgeLastTriedAt          DateTime?

  /// MUT-115 (ADR-190): this person's passkeys, and the creation challenges they asked for.
  passkeys            Passkey[]
  webauthnChallenges  WebauthnChallenge[]

  @@map("users")
}

/// What an unsorted capture becomes once filed: an Expense, or income
/// (Received or Owed — that finer choice is made at filing time, not here).
enum InboxEntryKind {
  INCOME
  EXPENSE
}

/// A user's own unsorted capture, before it is filed to a profile (MUT-66).
/// Deliberately has no Organization FK: the one user-owned, not
/// organization-owned, row shape in this schema, which is what makes
/// "removing a user's last membership does not delete their inbox" true by
/// construction rather than by a guard. Hard-deleted on explicit delete and on
/// successful filing — there is no audit value in a tombstone for a pre-ledger
/// scratch note once the real record (with its own audit row) exists.
model InboxEntry {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id])
  kind          InboxEntryKind
  amountMinor   BigInt
  currency      String         @db.VarChar(3)
  /// The date as the capturing device understood it. No organization timezone
  /// exists yet to validate "future" against — that check happens at filing
  /// time, against the chosen profile's own timezone.
  occurredOn    String         @db.VarChar(10)
  note          String?
  /// Persisted, unlike the captureSource of MUT-42/65 (audit metadata only):
  /// an entry can sit unfiled for a while, and the UI keeps showing "captured
  /// via Siri" across that whole lifetime, not just at the moment of a write.
  captureSource String?        @db.VarChar(20)
  version       Int            @default(1)
  createdAt     DateTime
  updatedAt     DateTime

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("inbox_entries")
}

/// Access/no-access: the user may see this organization's hosted profile.
model Membership {
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id])
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id])
  /// MUT-300 (ADR-099): read only while the organization's firm features are on; inert
  /// elsewhere (the OWNER default included). MUT-305 enforces it.
  role           MembershipRole @default(OWNER)
  createdAt      DateTime

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// cookie: the browser portal session (MUT-38); device: a native app's bearer
/// token (MUT-64). Same table, same revocation paths either way.
enum SessionKind {
  cookie
  device
}

/// MUT-235: SETUP is a person's first password; RESET an operator reset of an existing one.
enum SetupLinkPurpose {
  SETUP
  RESET
  /// MUT-366 (ADR-159): a self-service signup, bound to an address; the user is created when it is redeemed.
  SIGNUP
}

/// MUT-235 (ADR-088): a one-time setup link. Only the HMAC digest of its token
/// is stored (the session digest, same pepper). At most one of usedAt /
/// cancelledAt is ever set; a newer link for the same person cancels this one.
/// MUT-366: a SIGNUP link has no user yet: it holds the normalised address and the signup page's language instead.
/// CHECK constraints (migration 20261023180000_mut366_signup_links): userId is null exactly for SIGNUP, and then
/// email and locale are set; otherwise both are null.
model AccountSetupToken {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String?           @db.Uuid
  user          User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// MUT-366: SIGNUP only, normalised (trim, NFKC, lower-case).
  email         String?
  /// MUT-366: SIGNUP only: 'en' | 'ar', the language the person signed up in.
  locale        String?           @db.VarChar(5)
  tokenDigest   String            @unique @db.VarChar(64)
  purpose       SetupLinkPurpose
  /// MUT-366: mailed to the address (signup, recovery), not handed over by the operator. Redeeming one verifies the address.
  mailed        Boolean           @default(false)
  createdAt     DateTime
  expiresAt     DateTime
  usedAt        DateTime?
  cancelledAt   DateTime?
  /// MUT-367: SIGNUP only: what the signup screen made of the address's domain, and why. The redeem opens a BUSINESS
  /// address at once and sends every other to review (PENDING_REVIEW). Null on a SIGNUP link issued before MUT-367.
  domainClass   EmailDomainClass?
  domainReasons String[]

  @@index([userId])
  @@index([email])
  @@map("account_setup_tokens")
}

/// MUT-367 (ADR-159 §7a, ADR-178): one self-service signup waiting for (or decided by) the operator. Written by the
/// SIGNUP redeem that opens a PENDING_REVIEW account. A decline hard-deletes the account; this row stays, with no
/// user and no address, as the record of the decision.
model SignupReview {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String?               @unique @db.Uuid
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The address's domain (punycode), never the address.
  domain         String                @db.VarChar(253)
  classification EmailDomainClass
  /// Why it waits, e.g. ["webmail"], ["rdap-age-12d"], ["no-mx", "rdap-not-found"].
  reasons        String[]
  createdAt      DateTime
  /// When the operator digest first counted it; null until a digest is sent (MUT-367 D13).
  notifiedAt     DateTime?
  decidedAt      DateTime?
  decision       SignupReviewDecision?
  /// Who decided: "admin-token" (the admin token carries no identity; D15).
  decidedBy      String?               @db.VarChar(64)

  @@index([createdAt])
  @@map("signup_reviews")
}

/// MUT-324: where a terms acceptance happened; a session knows only cookie or device.
enum TermsSurface {
  portal
  phone
}

/// MUT-324 (ADR-102): one person's acceptance of one terms version. `textSha256`
/// fingerprints the frozen text in the language read (server/src/legal.ts).
/// Deleted with the person (D3): the schema's one cascade, chosen by the owner,
/// so closing an account (MUT-333) also removes the record of its agreement.
model TermsAcceptance {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// An ISO date; string order is release order.
  version       String       @db.VarChar(10)
  /// 'en' | 'ar', validated by the API.
  locale        String       @db.VarChar(5)
  textSha256    String       @db.Char(64)
  surface       TermsSurface
  /// MUT-354: the client release that showed the terms (`web-v<x>`), as sent; null for older clients and rows.
  clientRelease String?      @db.VarChar(64)
  acceptedAt    DateTime

  @@unique([userId, version])
  @@map("terms_acceptances")
}

/// A server-side session (MUT-38 cookie, MUT-64 device). Only the
/// HMAC-SHA256 digest (SESSION_TOKEN_PEPPER) of the token is stored, whether
/// it travels as a cookie or a bearer token.
model Session {
  id                    String      @id @default(uuid()) @db.Uuid
  userId                String      @db.Uuid
  user                  User        @relation(fields: [userId], references: [id])
  tokenDigest           String      @unique @db.VarChar(64)
  kind                  SessionKind @default(cookie)
  createdAt             DateTime
  /// MUT-237: when this session last proved the current password; the middleware compares it with users.passwordChangedAt.
  credentialsVerifiedAt DateTime
  lastSeenAt            DateTime
  idleExpiresAt         DateTime
  absoluteExpiresAt     DateTime
  revokedAt             DateTime?
  revokedReason         String?
  /// Truncated to 200 characters; for the operator's eyes only.
  userAgent             String?     @db.VarChar(200)
  /// MUT-115 (A2/D6): the passkey that opened this session; removing the passkey revokes it.
  passkeyId             String?     @db.Uuid
  passkey               Passkey?    @relation(fields: [passkeyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([passkeyId])
  @@map("sessions")
}

/// MUT-115 (ADR-190): a WebAuthn credential that signs its person in (portal and iOS app, RP ID = the apex domain).
/// Only the public key is stored. A password change keeps passkeys; removing one revokes the sessions it opened.
model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// base64url credential id, as the authenticator reports it.
  credentialId String    @unique @db.VarChar(1366)
  /// COSE public key.
  publicKey    Bytes
  /// SC2: the WebAuthn signature counter is a uint32, beyond Int's range.
  signCount    BigInt
  transports   String[]
  /// 'singleDevice' | 'multiDevice' (synced, e.g. iCloud Keychain).
  deviceType   String    @db.VarChar(16)
  backedUp     Boolean
  aaguid       String    @db.VarChar(36)
  /// Named from the AAGUID's provider or the User-Agent (DR8); the person may rename it. 1–64 characters.
  name         String    @db.VarChar(64)
  createdAt    DateTime
  lastUsedAt   DateTime?

  sessions Session[]

  @@index([userId])
  @@map("passkeys")
}

enum WebauthnChallengePurpose {
  creation
  authentication
}

/// MUT-115 (D5): a single-use WebAuthn challenge, valid 5 minutes, consumed by one conditional UPDATE. A creation
/// challenge is bound to the person who asked; an authentication challenge (sign-in) to no one.
model WebauthnChallenge {
  id         String                   @id @default(uuid()) @db.Uuid
  challenge  String                   @db.VarChar(128)
  purpose    WebauthnChallengePurpose
  userId     String?                  @db.Uuid
  user       User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([expiresAt])
  @@index([userId])
  @@map("webauthn_challenges")
}

/// A binding between an organization and an external system's tenant.
/// Disconnecting flips status and keeps the row, so the external references
/// recorded on customers/projects (M2) survive for a safe reconnection
/// (plan §10.4).
model Integration {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @db.Uuid
  organization        Organization        @relation(fields: [organizationId], references: [id])
  provider            IntegrationProvider
  /// The external system's own tenant identifier (Malafat tenant id).
  externalTenantId    String
  displayName         String
  status              IntegrationStatus
  connectedByApiKeyId String?             @db.Uuid
  connectedAt         DateTime
  disconnectedAt      DateTime?
  updatedAt           DateTime            @updatedAt

  @@unique([organizationId, provider])
  @@unique([provider, externalTenantId])
  @@map("integrations")
}

/// Append-only. No update or delete path exists in the application layer
/// (plan §13.2, §15.2 "audit records cannot be modified through ordinary APIs").
model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id])
  actorType      AuditActorType
  /// API key id, admin principal, or null for SYSTEM.
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  requestId      String?
  createdAt      DateTime       @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([organizationId, entityType, entityId, createdAt])
  @@map("audit_events")
}

/// Plan §14.2: key, operation, request fingerprint, execution status and the
/// stored outcome. Same key + same fingerprint replays the outcome; same key +
/// different fingerprint is rejected.
model IdempotencyKey {
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id])
  key            String            @db.VarChar(128)
  operation      String
  fingerprint    String            @db.VarChar(64)
  status         IdempotencyStatus
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  completedAt    DateTime?

  @@id([organizationId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// MUT-131: the same contract as IdempotencyKey, keyed by user instead of
/// organization — for the organization-independent inbox create (MUT-66's
/// POST /v1/inbox has no organization to key against, the same reason
/// InboxEntry itself has no organizationId). Kept as its own table rather
/// than a polymorphic owner column on IdempotencyKey: every other caller of
/// that table is organization-scoped, and this is the first of its kind.
model UserIdempotencyKey {
  userId         String            @db.Uuid
  user           User              @relation(fields: [userId], references: [id])
  key            String            @db.VarChar(128)
  operation      String
  fingerprint    String            @db.VarChar(64)
  status         IdempotencyStatus
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  completedAt    DateTime?

  @@id([userId, key])
  @@index([createdAt])
  @@map("user_idempotency_keys")
}

// ---- Milestone 2: customers, projects, external references ----------------

/// The party money is owed by. Thin on purpose: Malafat holds the rich client
/// record and names ours through an ExternalReference (M2 brief §2.1).
model Customer {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  notes          String?
  /// Default VAT treatment for this customer's items (e.g. OUT_OF_SCOPE for a foreign client).
  vatTreatment   VatTreatment?
  status         EntityStatus  @default(ACTIVE)
  archivedAt     DateTime?
  /// Optimistic concurrency: PATCH sends If-Match: <version>.
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())

  projects   Project[]
  agreements Agreement[]
  payments   Payment[]
  expenses   Expense[]

  @@index([organizationId, createdAt, id])
  @@map("customers")
}

/// The container every agreement, receivable and payment hangs off. One
/// currency per project (ADR-004); locked once anything is posted (M3).
model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id])
  customerId     String        @db.Uuid
  customer       Customer      @relation(fields: [customerId], references: [id])
  name           String
  currency       String        @db.VarChar(3)
  /// Default VAT treatment for this project's items; null inherits the customer's.
  vatTreatment   VatTreatment?
  status         EntityStatus  @default(ACTIVE)
  archivedAt     DateTime?
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())

  agreements Agreement[]
  expenses   Expense[]
  /// MUT-65: "Received" captured with a matter.
  payments   Payment[]

  @@index([organizationId, customerId])
  @@index([organizationId, createdAt, id])
  @@map("projects")
}

/// How an external system names one of our entities. Unique per
/// (organization, provider, entity type, external id) — a Malafat client and
/// matter may share an id — and one reference per entity per provider.
model ExternalReference {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id])
  provider       IntegrationProvider
  entityType     ExternalEntityType
  entityId       String              @db.Uuid
  externalId     String
  createdAt      DateTime            @default(now())

  @@unique([organizationId, provider, entityType, externalId])
  @@unique([provider, entityType, entityId])
  @@map("external_references")
}

// ---- Milestone 3: VAT rates, agreements, installments, retainer charges, receivables ----
//
// Amounts are BIGINT minor units (never float). Calendar dates are ISO strings
// (YYYY-MM-DD / YYYY-MM) in VarChar columns: they are organization-timezone
// calendar dates, not instants, and lexicographic order is chronological.

/// The firm's standard VAT rate, effective-dated and append-only.
model VatRate {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  rateBasisPoints Int
  effectiveFrom   String       @db.VarChar(10)
  createdAt       DateTime     @default(now())

  @@unique([organizationId, effectiveFrom])
  @@map("vat_rates")
}

model Agreement {
  id                        String              @id @default(uuid()) @db.Uuid
  organizationId            String              @db.Uuid
  organization              Organization        @relation(fields: [organizationId], references: [id])
  projectId                 String              @db.Uuid
  project                   Project             @relation(fields: [projectId], references: [id])
  customerId                String              @db.Uuid
  customer                  Customer            @relation(fields: [customerId], references: [id])
  type                      AgreementType
  status                    AgreementStatus     @default(ACTIVE)
  currency                  String              @db.VarChar(3)
  pricingBasis              PricingBasis
  vatTreatment              VatTreatment
  /// Frozen at creation; 0 for non-standard treatments.
  vatRateBasisPoints        Int
  /// FIXED: contractual total in the pricing basis. RECURRING: the monthly amount.
  amountMinor               BigInt
  netMinor                  BigInt
  vatMinor                  BigInt
  grossMinor                BigInt
  agreementDate             String              @db.VarChar(10)
  description               String?
  paymentTerms              PaymentTerms        @default(EOM)
  startMonth                String?             @db.VarChar(7)
  billingDay                Int?
  endMonth                  String?             @db.VarChar(7)
  cancelEffectiveMonth      String?             @db.VarChar(7)
  /// The day the retainer stopped (M5); cancelEffectiveMonth is its month.
  cancelEffectiveDate       String?             @db.VarChar(10)
  finalMonth                FinalMonth?
  cancelledAt               DateTime?
  // CONTINGENCY only (MUT-100); a CHECK in the migration requires rate 1..10000 and a treatment on CONTINGENCY rows.
  commissionRateBasisPoints Int?
  upfrontTreatment          UpfrontTreatment?
  outcome                   ContingencyOutcome?
  outcomeDate               String?             @db.VarChar(10)
  awardedAmountMinor        BigInt?
  outcomeNote               String?
  outcomeRecordedAt         DateTime?
  version                   Int                 @default(1)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @default(now())

  installments Installment[]
  charges      RetainerCharge[]
  supplements  AgreementSupplement[]
  versions     RetainerVersion[]

  @@index([organizationId, projectId])
  @@index([organizationId, customerId])
  @@index([organizationId, createdAt, id])
  @@map("agreements")
}

model Installment {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  agreementId     String        @db.Uuid
  agreement       Agreement     @relation(fields: [agreementId], references: [id])
  position        Int
  label           String
  amountMinor     BigInt
  netMinor        BigInt
  vatMinor        BigInt
  grossMinor      BigInt
  vatTreatment    VatTreatment
  rateBasisPoints Int
  triggerType     TriggerType
  triggerDate     String?       @db.VarChar(10)
  paymentTerms    PaymentTerms?
  dueDateOverride String?       @db.VarChar(10)
  postedAt        DateTime?
  postingDate     String?       @db.VarChar(10)
  receivableId    String?       @unique @db.Uuid
  voidedAt        DateTime?
  /// MUT-100: the commission line a contingency outcome posts; never counted as upfront.
  isCommission    Boolean       @default(false)
  version         Int           @default(1)

  @@unique([agreementId, position])
  @@index([organizationId, triggerType, triggerDate])
  @@map("installments")
}

model RetainerCharge {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  agreementId     String       @db.Uuid
  agreement       Agreement    @relation(fields: [agreementId], references: [id])
  /// The retainer terms version this charge carries (M5).
  version         Int          @default(1)
  serviceMonth    String       @db.VarChar(7)
  chargeDate      String       @db.VarChar(10)
  amountMinor     BigInt
  netMinor        BigInt
  vatMinor        BigInt
  grossMinor      BigInt
  vatTreatment    VatTreatment
  rateBasisPoints Int
  postedAt        DateTime
  receivableId    String       @unique @db.Uuid
  createdAt       DateTime     @default(now())

  @@unique([agreementId, serviceMonth])
  @@map("retainer_charges")
}

/// An effective-dated version of a retainer's terms (M5). Version 1 is the agreement row itself and is not stored.
model RetainerVersion {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  agreementId        String       @db.Uuid
  agreement          Agreement    @relation(fields: [agreementId], references: [id])
  version            Int
  effectiveMonth     String       @db.VarChar(7)
  monthlyAmountMinor BigInt
  netMinor           BigInt
  vatMinor           BigInt
  grossMinor         BigInt
  pricingBasis       PricingBasis
  vatTreatment       VatTreatment
  rateBasisPoints    Int
  billingDay         Int
  paymentTerms       PaymentTerms
  endMonth           String?      @db.VarChar(7)
  reason             String
  requestId          String?
  createdAt          DateTime     @default(now())

  @@unique([agreementId, version])
  @@index([organizationId, agreementId])
  @@map("retainer_versions")
}

/// What is owed. Created only when an installment or charge posts.
model Receivable {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  organization       Organization        @relation(fields: [organizationId], references: [id])
  customerId         String              @db.Uuid
  /// Null for an "Owed" capture with no matter (MUT-65, origin ADJUSTMENT); always set for INSTALLMENT/RETAINER_CHARGE. No FK here, matching this model's existing customerId/agreementId columns.
  projectId          String?             @db.Uuid
  agreementId        String?             @db.Uuid
  origin             ReceivableOrigin
  originId           String?             @db.Uuid
  currency           String              @db.VarChar(3)
  netMinor           BigInt
  vatMinor           BigInt
  grossMinor         BigInt
  vatTreatment       VatTreatment
  vatRateBasisPoints Int
  /// Σ allocations from POSTED payments (M4).
  paidMinor          BigInt              @default(0)
  /// Σ credits (M4). Outstanding = gross − paid − credited.
  creditedMinor      BigInt              @default(0)
  dueDate            String              @db.VarChar(10)
  postingDate        String              @db.VarChar(10)
  postedAt           DateTime
  status             ReceivableStatus    @default(OPEN)
  /// "What you did" (MUT-65, ADJUSTMENT origin only); null for INSTALLMENT/RETAINER_CHARGE.
  title              String?
  /// Who captured it (MUT-65, ADJUSTMENT origin only); no FK, matching customerId/projectId above.
  createdByUserId    String?             @db.Uuid
  /// Soft-delete for the undo path (MUT-65); mirrors Expense.deletedAt.
  deletedAt          DateTime?
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  allocations        PaymentAllocation[]
  credits            ReceivableCredit[]

  @@index([organizationId, customerId])
  @@index([organizationId, projectId])
  @@index([organizationId, dueDate])
  @@index([organizationId, createdAt, id])
  /// MUT-270: the entries feed reads Owed (ADJUSTMENT) rows only, newest logged first.
  @@index([organizationId, origin, createdAt, id])
  /// MUT-390: the entries feed's Owed rows by money date (postingDate), newest day first, then newest logged.
  @@index([organizationId, origin, postingDate(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@map("receivables")
}

model AgreementSupplement {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @db.Uuid
  agreementId          String                 @db.Uuid
  agreement            Agreement              @relation(fields: [agreementId], references: [id])
  amountMinor          BigInt
  description          String?
  effectiveDate        String                 @db.VarChar(10)
  distribution         SupplementDistribution
  resultingAmountMinor BigInt
  requestId            String?
  createdAt            DateTime               @default(now())

  @@index([agreementId, createdAt])
  @@map("agreement_supplements")
}

/// Money received from a customer (M4). Immutable once posted except through
/// `reverse` (status, reversedAt, reason) and `allocations` (new rows).
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  organization      Organization  @relation(fields: [organizationId], references: [id])
  /// Null for "Received" captured with no client (MUT-65); always set for a Malafat-fed payment.
  customerId        String?       @db.Uuid
  /// onDelete: Restrict, unchanged from the M4 migration — the nullability change here is the column, not this constraint's delete behavior.
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Optional matter the money is for (MUT-65). Never set by a Malafat-fed payment, which carries the link through its allocations instead.
  projectId         String?       @db.Uuid
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// PAY-YYYY-NNNN, gap-free per organization and year (payment_counters).
  number            String
  currency          String        @db.VarChar(3)
  amountMinor       BigInt
  /// Σ allocations; unallocated = amount − allocated. 0 once reversed.
  allocatedMinor    BigInt        @default(0)
  receivedOn        String        @db.VarChar(10)
  method            PaymentMethod
  reference         String?
  notes             String?
  status            PaymentStatus @default(POSTED)
  reversedAt        DateTime?
  reversalReason    String?
  replacesPaymentId String?       @db.Uuid
  requestId         String?
  /// Who captured it (MUT-65); null for a Malafat-fed payment, which has no session actor.
  createdByUserId   String?       @db.Uuid
  /// MUT-61: INTEGRATION when Malafat's key recorded it, CAPTURE when a person did (POST /v1/income, inbox filing).
  /// Durable where createdByUserId is not: that column is SetNull when the user goes.
  origin            PaymentOrigin @default(INTEGRATION)
  /// MUT-61: the surface a capture came from (CaptureSourceSchema: app, siri, …); null when not sent, and always for INTEGRATION.
  captureSource     String?       @db.VarChar(20)
  createdBy         User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now())

  allocations PaymentAllocation[]

  @@unique([organizationId, number])
  @@index([organizationId, customerId])
  @@index([organizationId, projectId])
  @@index([organizationId, createdAt, id])
  /// MUT-390: the entries feed by money date (receivedOn), newest day first, then newest logged.
  @@index([organizationId, receivedOn(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@map("payments")
}

/// MUT-61: who put a payment on the ledger — Malafat's integration, or a person capturing money they were handed.
enum PaymentOrigin {
  INTEGRATION
  CAPTURE
}

model PaymentAllocation {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  paymentId      String     @db.Uuid
  payment        Payment    @relation(fields: [paymentId], references: [id])
  receivableId   String     @db.Uuid
  receivable     Receivable @relation(fields: [receivableId], references: [id])
  amountMinor    BigInt
  createdAt      DateTime   @default(now())

  @@index([organizationId, paymentId])
  @@index([organizationId, receivableId])
  @@map("payment_allocations")
}

/// Append-only credits against a posted receivable (M4 brief decision 5).
model ReceivableCredit {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  receivableId   String     @db.Uuid
  receivable     Receivable @relation(fields: [receivableId], references: [id])
  /// Positive magnitudes; net + vat = amount, VAT at the receivable's frozen rate.
  amountMinor    BigInt
  netMinor       BigInt
  vatMinor       BigInt
  reason         String
  effectiveDate  String     @db.VarChar(10)
  requestId      String?
  createdAt      DateTime   @default(now())

  @@index([organizationId, receivableId])
  @@map("receivable_credits")
}

/// Next payment sequence per organization and year; the row lock serialises numbering.
model PaymentCounter {
  organizationId String @db.Uuid
  year           Int
  next           Int

  @@id([organizationId, year])
  @@map("payment_counters")
}

enum AttachmentKind {
  INVOICE
  RECEIPT
  OTHER
}

enum AttachmentStatus {
  PENDING_UPLOAD
  READY
}

/// A file in the private attachments bucket (M6). Bytes never pass through the API; the key is org/{organizationId}/{id}.
model Attachment {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  organization    Organization     @relation(fields: [organizationId], references: [id])
  kind            AttachmentKind
  filename        String
  mimeType        String
  sizeBytes       Int
  status          AttachmentStatus @default(PENDING_UPLOAD)
  storageKey      String
  customerId      String?          @db.Uuid
  projectId       String?          @db.Uuid
  paymentId       String?          @db.Uuid
  invoiceNumber   String?
  invoiceDate     String?          @db.VarChar(10)
  uploadedByKeyId String?
  requestId       String?
  createdAt       DateTime         @default(now())
  completedAt     DateTime?
  deletedAt       DateTime?

  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, paymentId, createdAt])
  @@map("attachments")
}

// ---- Milestone 7: fee proposals (negotiations before an agreement) ----------

enum FeeProposalStatus {
  PROPOSED
  APPROVED
  WITHDRAWN
}

/// A fee proposed on a project before any agreement exists (M7 brief §3–§4,
/// lifecycle revised by M8 §6): proposed → approved (the approval creates the
/// agreement in the same transaction) or withdrawn. One open proposal per
/// project, serialised by the project row lock in the repository. Amounts are
/// minor units in the project currency; dates are organization calendar dates.
model FeeProposal {
  id                        String            @id @default(uuid()) @db.Uuid
  organizationId            String            @db.Uuid
  organization              Organization      @relation(fields: [organizationId], references: [id])
  projectId                 String            @db.Uuid
  customerId                String            @db.Uuid
  currency                  String            @db.VarChar(3)
  status                    FeeProposalStatus @default(PROPOSED)
  pricingBasis              PricingBasis
  proposedAmountMinor       BigInt
  proposedOn                String            @db.VarChar(10)
  note                      String?
  clientApprovedOn          String?           @db.VarChar(10)
  clientApprovalNote        String?
  /// Null while PROPOSED / WITHDRAWN; the final amount once APPROVED.
  agreedAmountMinor         BigInt?
  withdrawnAt               DateTime?
  withdrawnReason           String?
  /// The agreement the approval created (APPROVED).
  agreementId               String?           @unique @db.Uuid
  /// MUT-107: both set on a contingency proposal, both null on a FIXED one (CHECK in migration).
  commissionRateBasisPoints Int?
  upfrontTreatment          UpfrontTreatment?
  requestId                 String?
  version                   Int               @default(1)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @default(now())

  @@index([organizationId, projectId])
  @@index([organizationId, customerId])
  @@index([organizationId, createdAt, id])
  @@map("fee_proposals")
}

// ---- MUT-42: expenses on hosted profiles ------------------------------------
// Additive: three new tables, nothing existing altered. Session-only; Malafat's
// key reaches none of it (hosted-portal.md §5, mut-42-hosted-expenses.md).

/// One expense in its original amount and currency — never converted. Soft-deleted.
model Expense {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  organization    Organization     @relation(fields: [organizationId], references: [id])
  /// Calendar date in the organization timezone, YYYY-MM-DD.
  occurredOn      String           @db.VarChar(10)
  amountMinor     BigInt
  currency        String           @db.VarChar(3)
  title           String?
  /// The vendor as typed (history and display). MUT-254 links it to `vendorId`.
  vendor          String?
  vendorId        String?          @db.Uuid
  vendorRef       Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  categoryId      String?          @db.Uuid
  category        ExpenseCategory? @relation(fields: [categoryId], references: [id])
  customerId      String?          @db.Uuid
  customer        Customer?        @relation(fields: [customerId], references: [id])
  projectId       String?          @db.Uuid
  project         Project?         @relation(fields: [projectId], references: [id])
  notes           String?
  /// MUT-333 (D7): null once the person who entered it has deleted their account ("former member").
  createdByUserId String?          @db.Uuid
  createdBy       User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  version         Int              @default(1)
  createdAt       DateTime
  updatedAt       DateTime
  deletedAt       DateTime?

  receipts       ExpenseReceipt[]
  /// MUT-267: keep/leave-out marks on this expense, one per group at most.
  groupOverrides ExpenseGroupOverride[]

  /// The ledger and the summary: newest first by date within an organization.
  @@index([organizationId, occurredOn(sort: Desc), id(sort: Desc)])
  /// A client's and a matter's expenses.
  @@index([organizationId, customerId, occurredOn])
  @@index([organizationId, projectId, occurredOn])
  /// Whether a category is in use.
  @@index([organizationId, categoryId])
  /// MUT-182: a type change deletes categories; ON DELETE SET NULL then probes expenses by categoryId alone.
  @@index([categoryId])
  /// MUT-254: a vendor's expenses (the backfill's re-link check, MUT-308 bills).
  @@index([organizationId, vendorId])
  /// MUT-270: the entries feed, newest logged first within an organization.
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  /// MUT-390: the entries feed by money date, newest day first, then newest logged.
  @@index([organizationId, occurredOn(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@map("expenses")
}

/// A per-organization expense category, as the offline ExpenseCategory. Archived, never deleted.
model ExpenseCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  /// Trimmed, NFKC, lower-cased name: one category per spelling.
  nameKey        String
  color          String?      @db.VarChar(7)
  archivedAt     DateTime?
  version        Int          @default(1)
  createdAt      DateTime
  updatedAt      DateTime

  expenses Expense[]
  /// MUT-254: vendors whose last category this is.
  vendors  Vendor[]

  @@unique([organizationId, nameKey])
  @@index([organizationId, createdAt, id])
  @@map("expense_categories")
}

/// MUT-254: a vendor of a profile, saved automatically from any typed vendor (ADR-183). Matched exactly: registration
/// number first, then the normalised name or an alias (`VendorName`). Session-only: Malafat's API key never reads it.
model Vendor {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  organization    Organization     @relation(fields: [organizationId], references: [id])
  /// The first spelling typed, trimmed.
  canonicalName   String
  registrationNo  String?
  /// Digits only (vendors/keys.ts registrationKey); NULLs are distinct, so the unique index allows many unset.
  registrationKey String?
  phone           String?
  email           String?
  /// The category of the last expense saved with this vendor (never the automatic Other): the typeahead's prefill.
  lastCategoryId  String?          @db.Uuid
  lastCategory    ExpenseCategory? @relation(fields: [lastCategoryId], references: [id], onDelete: SetNull)
  /// Set on every successful link; the typeahead's "recent".
  lastUsedAt      DateTime
  version         Int              @default(1)
  createdAt       DateTime
  updatedAt       DateTime

  names    VendorName[]
  expenses Expense[]

  @@unique([organizationId, registrationKey])
  @@index([organizationId, lastUsedAt(sort: Desc)])
  /// A type change deletes categories; ON DELETE SET NULL then probes vendors by lastCategoryId alone (as MUT-182).
  @@index([lastCategoryId])
  @@map("vendors")
}

/// MUT-254: a vendor's canonical name and every alias. One row per normalised key per profile, so two saves of a new
/// name can never create two vendors.
model VendorName {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  vendorId       String       @db.Uuid
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name           String
  /// vendors/keys.ts vendorNameKey.
  nameKey        String
  createdAt      DateTime

  @@unique([organizationId, nameKey])
  @@index([vendorId])
  @@map("vendor_names")
}

/// MUT-255: where a receipt stands in the profile's receipts library. FILED exactly when it has an expense (DB CHECK
/// `expense_receipts_filed_has_record`); MUT-308 widens that to "or a bill".
enum ReceiptFilingStatus {
  TO_REVIEW
  FILED
}

/// A receipt file in the attachments bucket under org/{organizationId}/expense-receipts/{id}. Kept apart from `attachments`, which Malafat reads.
/// MUT-255: a receipt belongs to its profile; its expense is optional (a To-review receipt has none yet).
model ExpenseReceipt {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  organization     Organization        @relation(fields: [organizationId], references: [id])
  expenseId        String?             @db.Uuid
  /// RESTRICT, as before MUT-255: expenses are only soft-deleted, and SET NULL would break the filing CHECK.
  expense          Expense?            @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  filename         String
  mimeType         String
  sizeBytes        Int
  status           AttachmentStatus    @default(PENDING_UPLOAD)
  /// Defaults to FILED, not TO_REVIEW: a revision that predates MUT-255 inserts with an expense and no filing status,
  /// and must pass the CHECK during a rolling deploy. The library route sets TO_REVIEW itself.
  filingStatus     ReceiptFilingStatus @default(FILED)
  /// The upload day in the profile's timezone (YYYY-MM-DD), like every other `…On` date; the library's date filter.
  /// The UTC-day default only serves inserts from a revision that predates MUT-255 (rolling deploy); this one always sets it.
  receivedOn       String              @default(dbgenerated("to_char((now() AT TIME ZONE 'UTC'::text), 'YYYY-MM-DD'::text)")) @db.VarChar(10)
  storageKey       String
  /// MUT-333 (D7): null once the uploader has deleted their account.
  uploadedByUserId String?             @db.Uuid
  uploadedBy       User?               @relation("ReceiptUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  /// What the device's reader suggested (firm-books brief §6.1 `ReceiptSuggestion`); null when nothing was read.
  suggested        Json?
  /// What approval wrote into the expense; kept after an unlink, for the edit-rate figure.
  approved         Json?
  approvedAt       DateTime?
  approvedByUserId String?             @db.Uuid
  approvedBy       User?               @relation("ReceiptApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  version          Int                 @default(1)
  requestId        String?
  createdAt        DateTime
  completedAt      DateTime?
  deletedAt        DateTime?

  /// The receipts of one expense.
  @@index([organizationId, expenseId, createdAt])
  /// MUT-255: the library list and its counts.
  @@index([organizationId, filingStatus, receivedOn, createdAt])
  @@map("expense_receipts")
}

/// A logged currency-conversion event (MUT-161, server side of MUT-141): money moved from one
/// currency to another, in its own table rather than a kind column on an existing model — every
/// other kind of hosted write (Expense, Receivable, Payment) is its own model, and a separate table
/// is also what makes exclusion from every summary query structural rather than an allowlist to
/// maintain. Create + read only (no update/delete): a logging mistake is corrected with a new entry.
model Conversion {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  /// Calendar date in the organization timezone, YYYY-MM-DD.
  occurredOn      String       @db.VarChar(10)
  /// The source leg.
  amountMinor     BigInt
  currency        String       @db.VarChar(3)
  /// The destination leg. Never equal to `currency` (ADR TBD / route validation).
  toAmountMinor   BigInt
  toCurrency      String       @db.VarChar(3)
  notes           String?
  /// MUT-333 (D7): null once the person who logged it has deleted their account.
  createdByUserId String?      @db.Uuid
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  version         Int          @default(1)
  createdAt       DateTime
  updatedAt       DateTime
  deletedAt       DateTime?

  /// The ledger: newest first by date within an organization.
  @@index([organizationId, occurredOn(sort: Desc), id(sort: Desc)])
  /// MUT-270: the entries feed, newest logged first within an organization.
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  /// MUT-390: the entries feed by money date, newest day first, then newest logged.
  @@index([organizationId, occurredOn(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@map("conversions")
}

/// MUT-267 (ADR-094): a named date range on one profile. Members are worked out
/// when read — dated inside the window (endOn, or a year after startOn when still
/// going) and not left out, or kept — never stored.
model ExpenseGroup {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String       @db.VarChar(120)
  /// Calendar dates in the organization timezone, YYYY-MM-DD; endOn null = still going.
  startOn         String       @db.VarChar(10)
  endOn           String?      @db.VarChar(10)
  notes           String?
  /// MUT-333 (D7): null once the person who made it has deleted their account.
  createdByUserId String?      @db.Uuid
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  version         Int          @default(1)
  createdAt       DateTime
  updatedAt       DateTime
  deletedAt       DateTime?

  overrides ExpenseGroupOverride[]

  /// The groups list: newest start first within an organization.
  @@index([organizationId, startOn(sort: Desc), id(sort: Desc)])
  @@map("expense_groups")
}

/// MUT-267: one keep ('included') or leave-out ('excluded') mark per (group, expense).
/// Last write wins; deleting the row resets the expense to the date rule.
model ExpenseGroupOverride {
  groupId        String       @db.Uuid
  group          ExpenseGroup @relation(fields: [groupId], references: [id])
  expenseId      String       @db.Uuid
  expense        Expense      @relation(fields: [expenseId], references: [id])
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// 'excluded' | 'included' (CHECK constraint in the migration).
  mode           String       @db.VarChar(8)
  createdAt      DateTime
  updatedAt      DateTime

  @@id([groupId, expenseId])
  /// "Which groups is this expense in?" (GET /v1/expense-groups?expenseId=).
  @@index([expenseId])
  @@map("expense_group_overrides")
}

// ---- MUT-358 (ADR-160): billing core ---------------------------------------
// The person pays; the profile is what's entitled (server/src/billing/entitlement.ts). Stripe is the source of
// truth for subscriptions: MUT-360's webhook and nightly reconcile write them. Nothing here is enforced until MUT-361.

enum BillingTier {
  FREELANCER
  FIRM
}

/// MUT-358: one Stripe customer. userId is NULL while the customer is unlinked (MUT-360 stores those; the
/// operator links them with `billing link`). SET NULL on user deletion: the Stripe customer outlives the person.
model BillingAccount {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String?               @unique @db.Uuid
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripeCustomerId String                @unique
  /// ISO 3166-1 alpha-2, from Stripe's customer address.
  country          String?               @db.VarChar(2)
  /// 'ILS' for Israel, 'USD' elsewhere (billing-spike.md §0).
  currency         String                @db.VarChar(3)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  subscriptions    BillingSubscription[]

  @@map("billing_accounts")
}

/// MUT-358: a mirror of one Stripe subscription. `status` is Stripe's own string. A Firm subscription carries the
/// organization it pays for; SET NULL if that profile is deleted, since Stripe still bills until it is cancelled.
model BillingSubscription {
  id                   String         @id @default(uuid()) @db.Uuid
  billingAccountId     String         @db.Uuid
  billingAccount       BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  stripeSubscriptionId String         @unique
  tier                 BillingTier
  organizationId       String?        @db.Uuid
  organization         Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  status               String         @db.VarChar(32)
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean        @default(false)
  /// The Stripe Price's lookup_key (`freelancer_founder_monthly_ils` …).
  priceLookupKey       String?        @db.VarChar(100)
  /// The end of a founder-price lock (12 months, D4).
  founderUntil         DateTime?
  /// Stripe's own last-change time, so an older event never overwrites a newer state (MUT-360).
  stripeUpdatedAt      DateTime
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([billingAccountId])
  @@index([organizationId])
  @@map("billing_subscriptions")
}

/// MUT-358: an operator grant. Exactly one of userId (the person's own profiles) and organizationId (that profile)
/// is set (CHECK in the migration). Never deleted: revoking sets revokedAt, so "who was covered when" stays answerable.
model EntitlementGrant {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier           BillingTier
  reason         String        @db.VarChar(200)
  expiresAt      DateTime?
  /// `admin` for the admin API and CLI; `migration:mut358` for the pre-billing backfill.
  grantedBy      String        @db.VarChar(64)
  createdAt      DateTime      @default(now())
  revokedAt      DateTime?

  @@index([userId])
  @@index([organizationId])
  @@map("entitlement_grants")
}

/// MUT-433 (ADR-196): a per-user feature flag the operator turned on. One row per person and feature: a grant after a
/// revoke re-opens it (revokedAt null, grantedAt the new instant); the history is in audit_events. Names are the closed
/// set in server/src/features.ts, stored as text so a new flag needs no migration.
model UserFeatureGrant {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String    @db.VarChar(64)
  /// `admin` for the admin API and CLI.
  grantedBy String    @db.VarChar(64)
  grantedAt DateTime
  /// Set while the flag is off; null while it is on.
  revokedAt DateTime?

  @@unique([userId, feature])
  @@index([feature])
  @@map("user_feature_grants")
}

/// MUT-358: Stripe webhook events already handled, for idempotency and replay. MUT-360 writes it.
model StripeEvent {
  id          String    @id
  type        String    @db.VarChar(100)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@map("stripe_events")
}

/// MUT-359 (ADR-159 §5): where a send stands. FAILED rows don't count toward the caps; UNCERTAIN ones (a timeout the
/// provider may still have accepted) do. Both may be claimed again.
enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  UNCERTAIN
}

/// MUT-359: why an address gets no more mail. Only Resend's permanent bounces and complaints (D10).
enum EmailSuppressionReason {
  HARD_BOUNCE
  COMPLAINT
}

/// MUT-359 (D2, D16): the send log behind the mail caps and idempotency. Digests only: never an address or a body.
/// Pruned after 30 days by the API's hourly timer.
model EmailDelivery {
  id              String              @id @db.Uuid
  /// sha256 hex of the caller's idempotency key; also Resend's Idempotency-Key.
  keyDigest       String              @unique @db.VarChar(64)
  /// sha256 hex of the normalized recipient, for the per-recipient cap.
  recipientDigest String              @db.VarChar(64)
  template        String              @db.VarChar(40)
  locale          String              @db.VarChar(5)
  status          EmailDeliveryStatus
  providerId      String?             @db.VarChar(100)
  error           String?             @db.VarChar(200)
  createdAt       DateTime
  finishedAt      DateTime?

  @@index([createdAt])
  @@index([recipientDigest, createdAt])
  @@map("email_deliveries")
}

/// MUT-359 (D10): addresses the Resend webhook reported as a hard bounce or a complaint. The first event wins.
model EmailSuppression {
  /// normalizeEmail()'d.
  email     String                 @id
  reason    EmailSuppressionReason
  /// The svix-id of the webhook delivery that suppressed it.
  eventId   String                 @db.VarChar(100)
  createdAt DateTime

  @@map("email_suppressions")
}

/// MUT-333 (R1): a deleted profile's bucket prefix (`org/<id>/`) waiting to be emptied. Written in the hard delete's
/// own transaction, removed once the objects are gone; no foreign key, since the profile no longer exists.
model StoragePurge {
  organizationId String   @id @db.Uuid
  queuedAt       DateTime

  @@map("storage_purges")
}

/// MUT-434 (ADR-197): how an OAuth client registered. DCR = RFC 7591 at /oauth/register; CIMD = a Client ID Metadata
/// Document, whose URL is the client id.
enum OAuthClientKind {
  DCR
  CIMD
}

/// MUT-434: an MCP client known to the authorization server. Anonymous (registration is unauthenticated), so no user
/// FK and never purged with a person. A client that ever had a grant is kept (OV5: Claude stores its client id).
model OAuthClient {
  /// `mcl_…` for DCR, the metadata document URL for CIMD (capped at 2048).
  id                String          @id @db.VarChar(2048)
  kind              OAuthClientKind
  clientName        String          @db.VarChar(100)
  redirectUris      String[]
  createdAt         DateTime
  lastUsedAt        DateTime?
  /// CIMD only: when the document was fetched and when it goes stale (≤ 24 h, OV2). Null for DCR.
  metadataFetchedAt DateTime?
  metadataExpiresAt DateTime?

  requests OAuthAuthorizationRequest[]
  grants   OAuthGrant[]

  @@index([createdAt])
  @@map("oauth_clients")
}

/// MUT-434: one /oauth/authorize request waiting for the person's decision on /connect/approve (30 min, OV7).
model OAuthAuthorizationRequest {
  id            String      @id @default(uuid()) @db.Uuid
  clientId      String      @db.VarChar(2048)
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri   String      @db.VarChar(2048)
  codeChallenge String      @db.VarChar(64)
  scopes        String[]
  state         String?     @db.VarChar(500)
  /// The canonical resource the tokens will be bound to (S2a).
  resource      String      @db.VarChar(2048)
  createdAt     DateTime
  expiresAt     DateTime
  decidedAt     DateTime?
  /// Who decided it; set with decidedAt.
  userId        String?     @db.Uuid
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("oauth_authorization_requests")
}

/// MUT-434: one person's consent to one client. Several live grants per client are allowed (OV3). Every access check
/// reads it, so a revoke takes effect on the next call.
model OAuthGrant {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String      @db.VarChar(2048)
  /// OV5: Restrict, so a client with any grant (live or revoked) can't be cleaned up from under it.
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// The redirect the consent was given for, for the trust label in Connected apps.
  redirectUri   String      @db.VarChar(2048)
  scopes        String[]
  resource      String      @db.VarChar(2048)
  createdAt     DateTime
  /// Absolute: 180 days (D13).
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  revokedReason String?     @db.VarChar(32)

  codes  OAuthCode[]
  tokens OAuthToken[]

  @@index([userId])
  @@index([clientId])
  @@map("oauth_grants")
}

/// MUT-434: an authorization code (60 s, single use, D6). Only its digest is stored.
model OAuthCode {
  id            String     @id @default(uuid()) @db.Uuid
  codeDigest    String     @unique @db.VarChar(64)
  grantId       String     @db.Uuid
  grant         OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  codeChallenge String     @db.VarChar(64)
  redirectUri   String     @db.VarChar(2048)
  resource      String     @db.VarChar(2048)
  createdAt     DateTime
  expiresAt     DateTime
  consumedAt    DateTime?

  @@index([grantId])
  @@map("oauth_codes")
}

/// MUT-434: what an OAuth token is for.
enum OAuthTokenKind {
  ACCESS
  REFRESH
}

/// MUT-434: access (1 h) and refresh (45 d idle) tokens, by digest. A refresh token's rotation records `successorId`,
/// from which the successor pair is derived again on a retry inside 30 s (idempotent rotation, D19).
model OAuthToken {
  id          String         @id @default(uuid()) @db.Uuid
  tokenDigest String         @unique @db.VarChar(64)
  grantId     String         @db.Uuid
  grant       OAuthGrant     @relation(fields: [grantId], references: [id], onDelete: Cascade)
  kind        OAuthTokenKind
  createdAt   DateTime
  expiresAt   DateTime
  rotatedAt   DateTime?
  successorId String?        @db.Uuid

  @@index([grantId])
  @@map("oauth_tokens")
}
